# Copy this file to .env and fill in your API keys

# RapidAPI - JSearch
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=rozgar_unsigned
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Sign-In (Android)
GOOGLE_CLIENT_ID=your_google_client_id

# AdMob (test IDs for development)
ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_NATIVE_ID=ca-app-pub-3940256099942544/2247696110

# In-App Purchase
IAP_PREMIUM_PRODUCT_ID=rozgar_premium_monthly

# Cloud Function URL for IAP verification
IAP_VERIFY_URL=https://your-region-your-project.cloudfunctions.net/verifyPurchase
